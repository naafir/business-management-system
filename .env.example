# ==============================================================================
# Business Management & GST Billing System - Environment Configuration
# ==============================================================================

# Application Profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=business_billing_db
DB_USER=postgres
DB_PASSWORD=YOUR_SECURE_POSTGRES_PASSWORD_HERE

# JWT Authentication
# Must be at least 256 bits (32 characters or base64 encoded string)
JWT_SECRET=GENERATE_SECURE_RANDOM_SECRET_KEY_AT_LEAST_32_BYTES_LONG
JWT_EXPIRATION_MS=86400000

# Initial Admin/Owner Credentials (for first-time auto-bootstrap if needed)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=owner@mybusiness.local
INITIAL_ADMIN_PASSWORD=YOUR_INITIAL_ADMIN_PASSWORD_HERE

# Storage Configuration (LOCAL | S3)
STORAGE_TYPE=LOCAL
STORAGE_LOCAL_DIR=./uploads

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1
